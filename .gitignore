# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Node (frontend)
frontend/node_modules/
frontend/.next/

# Environment variables — NEVER commit these
.env
.env.local
frontend/.env.local
frontend/.env*.local

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# UV lock — commit this so Render gets a reproducible install
# uv.lock

# Data outputs (generated by pipeline — can be large)
data/outputs/*.html
data/outputs/*.pdf
# data/raw CSVs are committed so Render has sample data at boot


# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Next.js build
frontend/.next/
frontend/out/

# Docker
*.log


# Data outputs (generated at runtime)
data/outputs/
data/processed/
