# AnalytixAI Frontend — Environment Variables Template
# For local dev: copy to .env.local and fill in real values.
# For Vercel production: set these in Vercel Dashboard → Settings → Environment Variables
# NEVER commit .env.local with real secrets.

# Render backend URL (production)
NEXT_PUBLIC_API_URL=https://analytixai-klw3.onrender.com

# Supabase (only NEXT_PUBLIC_* are safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Explicitly set WebSocket URL. If omitted, it's auto-derived from NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_WS_URL=wss://analytixai-klw3.onrender.com/ws/telemetry
